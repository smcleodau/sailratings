# SailRatings API — PRODUCTION environment template
# ─────────────────────────────────────────────────────────────────────────────
# This file uses 1Password secret references (op://...) for every secret.
# Resolve at run time with:
#
#   op run --env-file=api/.env.production.template -- <command>
#
# e.g.  op run --env-file=api/.env.production.template -- uvicorn irc_data.api.app:app
#       op run --env-file=api/.env.production.template -- bash -c 'env > /tmp/prod-env'
#       op run --env-file=api/.env.production.template -- railway variables --set "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY"
#
# For Railway: paste the resolved values into the service's Variables panel,
# or pipe through `railway variables --set` in a loop.
#
# 1Password vault: "Sail Ratings"
# 1Password item:  "Sail Ratings - Production"  (one entry per field below)
# Service-account access: HE6KUCDH3RDHZI3DX6EIMQO6Z4 must have read on the vault.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# ─── Database ────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically when Postgres is linked to the
# service; the line below is the fallback for manual deploys. app.py rewrites
# postgresql:// → postgresql+psycopg:// at boot.
DATABASE_URL=op://Sail Ratings/Sail Ratings - Production/DATABASE_URL

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=op://Sail Ratings/Sail Ratings - Production/ANTHROPIC_API_KEY

# ─── Stripe — LIVE keys ──────────────────────────────────────────────────────
# Webhook secret is per-endpoint; re-issue after the production webhook
# endpoint is created in the Stripe dashboard.
STRIPE_SECRET_KEY=op://Sail Ratings/Sail Ratings - Production/STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=op://Sail Ratings/Sail Ratings - Production/STRIPE_WEBHOOK_SECRET

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=op://Sail Ratings/Sail Ratings - Production/RESEND_API_KEY

# ─── PostHog (analytics) ─────────────────────────────────────────────────────
POSTHOG_API_KEY=op://Sail Ratings/Sail Ratings - Production/POSTHOG_API_KEY
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Admin gate ──────────────────────────────────────────────────────────────
# Bearer token for /admin/* endpoints. Rotate when team membership changes.
ADMIN_PASSWORD=op://Sail Ratings/Sail Ratings - Production/ADMIN_PASSWORD

# ─── URLs (env-derived; override only if a CDN or alt domain enters play) ────
FRONTEND_BASE_URL=https://sailratings.com
API_BASE_URL=https://api.sailratings.com
CORS_ORIGINS=https://sailratings.com,https://www.sailratings.com

# ─── Optional — only needed by cleanup audit scripts ─────────────────────────
# EXTEND_API_KEY=op://Sail Ratings/Sail Ratings - Production/EXTEND_API_KEY
