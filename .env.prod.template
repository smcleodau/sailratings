# SailRatings — PRODUCTION environment template (monorepo)
# ─────────────────────────────────────────────────────────────────────────────
# Single env file for the whole monorepo. Both the API (api/) and the web
# build (web/) read from this file. Secrets are 1Password references resolved
# at run/build time:
#
#   op run --env-file=.env.production.template -- uvicorn irc_data.api.app:app
#   op run --env-file=.env.production.template -- npm --prefix web run build
#
# For Railway deployments — populate the service Variables panels by piping:
#
#   op run --env-file=.env.production.template -- env | grep -E '^(ENVIRONMENT|DATABASE_URL|GEMINI|STRIPE|RESEND|POSTHOG|ADMIN|FRONTEND|API_BASE|CORS|NEXT_PUBLIC)' \
#     > /tmp/prod.env
#   # then push each line into the relevant Railway service via dashboard or CLI.
#
# Web (NEXT_PUBLIC_*) vars are baked in at BUILD time — `op run` must wrap the
# build command, not just `npm start`.
#
# 1Password
#   vault: "Sail Ratings"
#   item:  "Sail Ratings - Production"  (one entry per op:// field below)
#   SA:    HE6KUCDH3RDHZI3DX6EIMQO6Z4 (read access on the vault — verified)
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# ═════════════════════════════════════════════════════════════════════════════
# BACKEND (api/) — runtime
# ═════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically when Postgres is linked.
# app.py rewrites postgresql:// → postgresql+psycopg:// at boot.
DATABASE_URL=op://Sail Ratings/Sail Ratings - Production/DATABASE_URL

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=op://Sail Ratings/Sail Ratings - Production/GEMINI_API_KEY

# ─── Firecrawl (OPS-02-06) ───────────────────────────────────────────────────
# Discovery + parity-gated long-tail results sources only — NOT news (RSS) or
# PDFs. Budget-gated via crawl_budget_settings (daily hard stop + soft/hard
# period caps).
FIRECRAWL_API_KEY=op://Sail Ratings/Sail Ratings - Production/FIRECRAWL_API_KEY

# ─── Stripe — LIVE keys ──────────────────────────────────────────────────────
# Webhook secret is per-endpoint; re-issue after the production webhook
# endpoint is created in the Stripe dashboard.
STRIPE_SECRET_KEY=op://Sail Ratings/Sail Ratings - Production/STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=op://Sail Ratings/Sail Ratings - Production/STRIPE_WEBHOOK_SECRET

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=op://Sail Ratings/Sail Ratings - Production/RESEND_API_KEY

# ─── PostHog server-side ─────────────────────────────────────────────────────
POSTHOG_API_KEY=op://Sail Ratings/Sail Ratings - Production/POSTHOG_API_KEY
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Admin gate ──────────────────────────────────────────────────────────────
# Bearer token for /admin/* endpoints. Rotate when team membership changes.
ADMIN_PASSWORD=op://Sail Ratings/Sail Ratings - Production/ADMIN_PASSWORD

# ─── URLs (env-derived; override only if a CDN or alt domain enters play) ────
FRONTEND_BASE_URL=https://sailratings.com
API_BASE_URL=https://api.sailratings.com
CORS_ORIGINS=https://sailratings.com,https://www.sailratings.com

# ─── Optional — only needed by cleanup audit scripts ─────────────────────────
# EXTEND_API_KEY=op://Sail Ratings/Sail Ratings - Production/EXTEND_API_KEY


# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND (web/) — build time
# ═════════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_* are inlined into the client bundle at `npm run build`. They
# must be present when the build runs, not just when the server boots.

# ─── API base ────────────────────────────────────────────────────────────────
# Frontend's API client uses this for every request. Must end in /v1.
NEXT_PUBLIC_API_BASE=https://api.sailratings.com/v1

# ─── Admin page gate ─────────────────────────────────────────────────────────
# When unset/false, src/middleware.ts rewrites /justin → /. Production stays
# false unless you specifically want the admin surface live on
# sailratings.com.
NEXT_PUBLIC_ENABLE_ADMIN=false

# ─── PostHog (analytics, public side) ────────────────────────────────────────
# Public project key — safe to bake into the client bundle. Distinct from
# POSTHOG_API_KEY above (server-side, sees full project access).
NEXT_PUBLIC_POSTHOG_KEY=op://Sail Ratings/Sail Ratings - Production/NEXT_PUBLIC_POSTHOG_KEY

# Reverse-proxy paths so PostHog requests aren't blocked by content-blockers.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
