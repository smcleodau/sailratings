# SailRatings Web — PRODUCTION environment template
# ─────────────────────────────────────────────────────────────────────────────
# These vars are BAKED INTO the Next.js build at compile time (NEXT_PUBLIC_*),
# so they must be present when `npm run build` runs in the production
# pipeline — not just at runtime.
#
# Resolve via 1Password at build time:
#
#   op run --env-file=web/.env.production.template -- npm run build
#
# For Railway: set these in the web service's Variables panel before
# triggering a build.
#
# 1Password vault: "Sail Ratings"
# 1Password item:  "Sail Ratings - Production"
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# ─── API base ────────────────────────────────────────────────────────────────
# Frontend's API client uses this for every request. Must end in /v1.
NEXT_PUBLIC_API_BASE=https://api.sailratings.com/v1

# ─── Admin page gate ─────────────────────────────────────────────────────────
# When unset/false, src/middleware.ts rewrites /justin → /. Production should
# stay false unless you specifically want the admin surface live on
# sailratings.com.
NEXT_PUBLIC_ENABLE_ADMIN=false

# ─── PostHog (analytics, public side) ────────────────────────────────────────
# Public project key — safe to bake into the client bundle. Distinct from
# POSTHOG_API_KEY (server-side, in api/.env.production.template).
NEXT_PUBLIC_POSTHOG_KEY=op://Sail Ratings/Sail Ratings - Production/NEXT_PUBLIC_POSTHOG_KEY

# Reverse-proxy paths so PostHog requests aren't blocked by content-blockers.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
