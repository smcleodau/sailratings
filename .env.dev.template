# SailRatings — DEV environment
# Single source of truth for env-derived URLs: ENVIRONMENT.
# Existing copy lives at ~/.env on the dev box — copy secrets across.

ENVIRONMENT=dev

# ──────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://irc:irc@localhost:5433/irc_data

# ──────────────────────────────────────────────────────────────
# Secrets (resolved via op run)
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=op://Sail Ratings/Sail Ratings - Dev/GEMINI_API_KEY
ADMIN_PASSWORD=op://Sail Ratings/Sail Ratings - Dev/ADMIN_PASSWORD
RESEND_API_KEY=op://Sail Ratings/Sail Ratings - Dev/RESEND_API_KEY

# Stripe TEST keys (sk_test_…, whsec_…)
STRIPE_SECRET_KEY=op://Sail Ratings/Sail Ratings - Dev/STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=op://Sail Ratings/Sail Ratings - Dev/STRIPE_WEBHOOK_SECRET

# PostHog
POSTHOG_API_KEY=op://Sail Ratings/Sail Ratings - Dev/POSTHOG_API_KEY
NEXT_PUBLIC_POSTHOG_KEY=op://Sail Ratings/Sail Ratings - Dev/NEXT_PUBLIC_POSTHOG_KEY

# extend.ai — only needed when running scripts/audit_certs_extend*.py
EXTEND_API_KEY=op://Sail Ratings/Sail Ratings - Dev/EXTEND_API_KEY

# Firecrawl (web crawler)
FIRECRAWL_API_KEY=op://Sail Ratings/Sail Ratings - Dev/FIRECRAWL_API_KEY

# ──────────────────────────────────────────────────────────────
# Derived from ENVIRONMENT — uncomment only to override.
# ──────────────────────────────────────────────────────────────
# FRONTEND_BASE_URL=https://dev.sailratings.com
# API_BASE_URL=https://api.dev.sailratings.com
# CORS_ORIGINS=https://dev.sailratings.com,http://localhost:4200
# NEXT_PUBLIC_API_BASE=https://api.dev.sailratings.com/v1
NEXT_PUBLIC_ENABLE_ADMIN=true
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=/ingest
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
